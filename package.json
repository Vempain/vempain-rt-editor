{
  "name" : "@vempain/vempain-rt-editor",
  "version" : "0.1.0",
  "description" : "Vempain rich text editor component library",
  "author" : "Paul-Erik Törrönen",
  "license" : "GPL-2.0",
  "type" : "module",
  "packageManager" : "yarn@4.18.0",
  "main" : "./dist/index.js",
  "module" : "./dist/index.js",
  "types" : "./dist/index.d.ts",
  "exports" : {
    "." : {
      "import" : "./dist/index.js",
      "types" : "./dist/index.d.ts"
    }
  },
  "files" : [
    "dist"
  ],
  "scripts" : {
    "prebuild" : "node generateBuildInfo.js",
    "build" : "tsc -p tsconfig.build.json",
    "build:production" : "yarn prebuild && tsc -p tsconfig.build.json",
    "clean" : "rm -rf dist",
    "lint" : "eslint .",
    "lint:fix" : "eslint . --fix",
    "test" : "jest",
    "test:watch" : "jest --watch",
    "test:coverage" : "jest --coverage"
  },
  "peerDependencies" : {
    "@ant-design/icons" : "^6.2.3",
    "antd" : "^6.4.3",
    "dompurify" : "^3.4.5",
    "rc-virtual-list" : "^3.19.2",
    "react" : "^19.2.0",
    "react-dom" : "^19.2.0"
  },
  "devDependencies" : {
    "@ant-design/icons" : "^6.3.2",
    "@eslint/js" : "^10.0.1",
    "@testing-library/dom" : "^10.4.1",
    "@testing-library/jest-dom" : "^7.0.1",
    "@testing-library/react" : "^16.3.2",
    "@testing-library/user-event" : "^14.6.5",
    "@types/jest" : "^30.0.0",
    "@types/react" : "^19.2.18",
    "@types/react-dom" : "^19.2.4",
    "@typescript/native" : "npm:typescript@^7.0.2",
    "@typescript/typescript6" : "^6.0.2",
    "antd" : "^6.6.1",
    "dompurify" : "^3.4.13",
    "eslint" : "^10.8.1",
    "eslint-plugin-react-hooks" : "^7.1.1",
    "eslint-plugin-react-refresh" : "^0.5.4",
    "globals" : "^17.11.0",
    "jest" : "^30.4.2",
    "jest-environment-jsdom" : "^30.4.1",
    "rc-virtual-list" : "^3.19.2",
    "react" : "^19.2.8",
    "react-dom" : "^19.2.8",
    "ts-jest" : "^29.4.12",
    "typescript" : "^7.0.2",
    "typescript-eslint" : "^8.67.0"
  },
  "repository" : {
    "type" : "git",
    "url" : "git+https://github.com/Vempain/vempain-rt-editor.git"
  },
  "publishConfig" : {
    "registry" : "https://npm.pkg.github.com"
  }
