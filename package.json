{
  "name" : "@vempain/vempain-rt-editor",
  "version" : "0.1.0",
  "description" : "Vempain rich text editor component library",
  "author" : "Paul-Erik Torrönen",
  "license" : "GPL-2.0",
  "type" : "module",
  "packageManager" : "yarn@4.13.0",
  "main" : "./dist/index.js",
  "module" : "./dist/index.js",
  "types" : "./dist/index.d.ts",
  "exports" : {
    "." : {
      "import" : "./dist/index.js",
      "types" : "./dist/index.d.ts"
    }
  },
  "files" : [
    "dist"
  ],
  "scripts" : {
    "prebuild" : "node generateBuildInfo.js",
    "build" : "tsc -p tsconfig.build.json",
    "build:production" : "yarn prebuild && tsc -p tsconfig.build.json",
    "clean" : "rm -rf dist",
    "lint" : "eslint .",
    "lint:fix" : "eslint . --fix",
    "test" : "jest",
    "test:watch" : "jest --watch",
    "test:coverage" : "jest --coverage"
  },
  "peerDependencies" : {
    "@ant-design/icons" : "^6.2.3",
    "antd" : "^6.4.3",
    "dompurify" : "^3.4.5",
    "rc-virtual-list" : "^3.19.2",
    "react" : "^19.2.0",
    "react-dom" : "^19.2.0"
  },
  "devDependencies" : {
    "@ant-design/icons" : "^6.2.3",
    "@eslint/js" : "^10.0.1",
    "@testing-library/dom" : "^10.4.1",
    "@testing-library/jest-dom" : "^6.9.1",
    "@testing-library/react" : "^16.3.2",
    "@testing-library/user-event" : "^14.6.1",
    "@types/jest" : "^30.0.0",
    "@types/react" : "^19.2.15",
    "@types/react-dom" : "^19.2.3",
    "antd" : "^6.4.3",
    "dompurify" : "^3.4.5",
    "eslint" : "^10.4.0",
    "eslint-plugin-react-hooks" : "^7.1.1",
    "eslint-plugin-react-refresh" : "^0.5.2",
    "globals" : "^17.6.0",
    "jest" : "^30.4.2",
    "jest-environment-jsdom" : "^30.4.1",
    "rc-virtual-list" : "^3.19.2",
    "react" : "^19.2.6",
    "react-dom" : "^19.2.6",
    "ts-jest" : "^29.4.11",
    "typescript" : "^6.0.3",
    "typescript-eslint" : "^8.59.4"
  },
  "publishConfig" : {
    "registry" : "https://npm.pkg.github.com"
  }
}
