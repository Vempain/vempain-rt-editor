{
  "extends" : "./tsconfig.json",
  "compilerOptions" : {
    "noEmit" : false,
    "declaration" : true,
    "declarationMap" : true,
    "outDir" : "dist",
    "rootDir" : "src"
  },
  "include" : [
    "src"
  ],
  "exclude" : [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test-utils/**",
    "src/setupTests.ts",
    "src/jest-dom-types.d.ts"
  ]
}

